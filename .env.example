PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ====== Database
DB_STRING=mongodb://127.0.0.1:27017/whatsapp_agent

# ====== Admin dashboard auth
JWT_SECRET=change_this_secret
JWT_EXPIRE=7d

# ====== AI provider (gemini | openai | claude) - এখন শুধু gemini implemented
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_GAP_MS=1200
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# ====== Owner (তুমি)
OWNER_NAME=Kazi Mridul
OWNER_NUMBER=8801XXXXXXXXX
TIMEZONE=Asia/Dhaka

# ====== Server এ deploy করলে QR এর বদলে pairing code (local এ খালি রাখো)
WA_PAIRING_NUMBER=

# ====== Telegram escalation
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====== Bot কতটুকু কথা বলবে (greeting | full)
AGENT_MODE=greeting
GREETING_PAUSE_HOURS=12

# ====== Bot behaviour
BOT_ENABLED=true
DEBOUNCE_MS=8000
CONFIDENCE_THRESHOLD=0.6
MAX_MESSAGES_PER_TURN=3
HOURLY_MESSAGE_LIMIT=20
REPLY_TO_UNKNOWN_ONLY=false
